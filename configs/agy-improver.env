# Preset 4: Local Inference Solver (192.168.9.33:8080) + Antigravity CLI (`agy_cli`) Improver
# Usage:
#   cp configs/agy-improver.env .env
# Uses your local Qwen 3.8 model on 192.168.9.33:8080 for Solver rollouts and Judge,
# while delegating Improver (propose/compose/select/reflect) sessions to `agy -p`.

OPENCODE_CONFIG=/home/meldude/harness2/configs/opencode-local.json

# Use Antigravity CLI (`agy`) as the Improver channel
HARNESS2_PROPOSER_CHANNEL=agy_cli
HARNESS2_IMPROVER_MODEL=agy/default

# Solver and Judge on 192.168.9.33:8080
HARNESS2_SOLVER_MODEL=local/huihui-qwen3.8-flash-next-iq3_s
HARNESS2_JUDGE_MODEL=huihui-qwen3.8-flash-next-iq3_s
HARNESS2_JUDGE_BASE_URL=http://192.168.9.33:8080/v1
HARNESS2_JUDGE_API_KEY=local-key

HARNESS2_RUNS_DIR=runs/agy-improver
