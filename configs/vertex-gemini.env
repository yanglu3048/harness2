# Preset 1: Pure Vertex AI Gemini (OpenCode Substrate)
# Usage: cp configs/vertex-gemini.env .env
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex/gemini-2.5-flash
