# ==============================================================================
# Harness² Configuration (.env.example)
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
# Shell environment variables take precedence over values in .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud / Vertex AI Configuration
# Authenticate with: gcloud auth application-default login
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Path to a service account JSON key file if not using interactive ADC
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 2. Core Model Configuration
# - HARNESS2_SOLVER_MODEL:   Executor model in OpenCode's `provider/model` syntax
# - HARNESS2_IMPROVER_MODEL: Improver (editor/composer/selector/reflector) model
#                            in `provider/model` syntax (defaults to solver model)
# - HARNESS2_JUDGE_MODEL:    Bare model ID for benchmark grading (adapter adds
#                            the provider prefix automatically)
# ------------------------------------------------------------------------------
HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_JUDGE_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 3. Output & Run Storage
# Use a distinct HARNESS2_RUNS_DIR when changing models, task splits, or budgets.
# ------------------------------------------------------------------------------
HARNESS2_RUNS_DIR=runs

# ------------------------------------------------------------------------------
# 4. Optional: Codex Executor (`--substrate cx`) via `harness2-bridge`
# Run `harness2-bridge` (or `harness2-bridge --host 0.0.0.0` for WorkBuddy) to
# generate and print these values automatically.
# ------------------------------------------------------------------------------
# HARNESS2_CODEX_BASE_URL=http://127.0.0.1:4000/v1
# HARNESS2_CODEX_API_KEY=your-bridge-or-responses-api-key
# HARNESS2_CODEX_MODEL=gemini-2.5-flash
# HARNESS2_CODEX_CONTAINER_URL=http://host.docker.internal:4000/v1

# ------------------------------------------------------------------------------
# 5. Optional: Custom OpenAI-Compatible Judge Endpoint (JobBench only)
# Leave unset to use Vertex AI's OpenAI-compatible endpoint with ADC.
# ------------------------------------------------------------------------------
# HARNESS2_JUDGE_BASE_URL=https://api.openai.com/v1
# HARNESS2_JUDGE_API_KEY=sk-...
