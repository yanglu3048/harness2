# Preset 2: Vertex Gemini Executor + Vertex Claude Improver
# Usage: cp configs/vertex-claude-improver.env .env
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east5

HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex-anthropic/claude-sonnet-4-5@20250929
HARNESS2_JUDGE_MODEL=gemini-2.5-pro
HARNESS2_RUNS_DIR=runs/vertex-claude-improver
