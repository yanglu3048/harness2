# Preset 3: Codex Executor (`--substrate cx`) with Local LiteLLM Bridge
# 1. Start the bridge: harness2-bridge (or `harness2-bridge --host 0.0.0.0` for WorkBuddy)
# 2. Update HARNESS2_CODEX_BASE_URL and HARNESS2_CODEX_API_KEY below with bridge output
# 3. Copy to .env: cp configs/codex-bridge.env .env
# 4. Run setup: harness2-setup <bench> --substrate cx
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_JUDGE_MODEL=gemini-2.5-pro
HARNESS2_RUNS_DIR=runs/codex-bridge

HARNESS2_CODEX_BASE_URL=http://127.0.0.1:4000/v1
HARNESS2_CODEX_API_KEY=replace-with-bridge-key
HARNESS2_CODEX_MODEL=gemini-2.5-flash
HARNESS2_CODEX_CONTAINER_URL=http://host.docker.internal:4000/v1
